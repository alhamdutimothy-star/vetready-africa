    "/api/v1/admin/assessments/{id}/items": {
      "post": {
        "operationId": "AssessmentController_item",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "SINGLE_MCQ",
                      "MULTIPLE_RESPONSE",
                      "NUMERICAL",
                      "DATA_INTERPRETATION",
                      "CLINICAL_SCENARIO",
                      "FARM_SCENARIO",
                      "CASE",
                      "SHORT_TEXT",
                      "EXTENDED_TEXT",
                      "REPORT",
                      "TECHNICAL_SALES",
                      "FILE_IMAGE",
                      "PRACTICAL_PLACEHOLDER"
                    ]
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 12000
                  },
                  "presentation": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "options": {
                        "maxItems": 30,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            }
                          },
                          "required": ["id", "text"],
                          "additionalProperties": false
                        }
                      },
                      "assetId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "assetDescription": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "units": {
                        "type": "string",
                        "maxLength": 60
                      }
                    },
                    "additionalProperties": false
                  },
                  "answerKey": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "selected": {
                            "maxItems": 30,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "maxLength": 80
                            }
                          },
                          "value": {
                            "type": "number"
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "KNOWLEDGE",
                      "CASE",
                      "SIMULATION",
                      "PRACTICAL",
                      "WORKPLACE"
                    ]
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": ["INTRODUCTORY", "INTERMEDIATE", "ADVANCED"]
                  },
                  "evidenceType": {
                    "type": "string",
                    "enum": [
                      "KNOWLEDGE_ASSESSED",
                      "CASE_ASSESSED",
                      "SIMULATION_VERIFIED",
                      "PRACTICALLY_VERIFIED",
                      "WORKPLACE_VERIFIED"
                    ]
                  },
                  "groupVersionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "childVersionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "criterionIds": {
                    "minItems": 1,
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "code",
                  "version",
                  "type",
                  "prompt",
                  "presentation",
                  "answerKey",
                  "method",
                  "difficulty",
                  "evidenceType",
                  "groupVersionId",
                  "childVersionId",
                  "criterionIds"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "tags": ["assessment and development"]
      }
    },
